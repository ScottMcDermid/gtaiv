# Copy to .env and edit to override. `make env` does this for you.
# Docker Compose reads .env automatically; the Makefile reads it for the URLs it prints.

# Host port for the production app (nginx).  http://localhost:$PORT
PORT=8080

# Host port for the Vite dev server with hot reload.  http://localhost:$DEV_PORT
DEV_PORT=5173

# Build mode for the production image. Leave as production unless you are
# debugging the build itself.
NODE_ENV=production
